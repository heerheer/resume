# 站点访问密码（auth）——为空则跳过登录
SITE_PASSWORD=

# ── AI 优化（多行输入框「AI 优化」按钮）──
# OpenAI 兼容的 Chat Completions 端点。默认指向 Oracle OCI Generative AI 的 OpenAI 兼容端点，
# 也可改为任何 OpenAI 兼容网关（OneAPI / DeepSeek / 本地 vLLM 等）。
AI_API_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
# OpenAPI 兼容端点的 API Key
AI_API_KEY=
# 使用的模型 id（默认 cohere.command-a-03-2025，可换 gpt-oss / llama 等 OCI 支持的模型）
AI_MODEL=cohere.command-a-03-2025